<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F0F4F8">

    <ScrollView>
        <VerticalStackLayout Padding="30,50" Spacing="25" VerticalOptions="Center">

            <Label Text="👨‍💻 Sobre o Desenvolvedor"
                   FontFamily="Kalam-Bold"
                   FontSize="35"
                   TextColor="#003366"
                   HorizontalOptions="Center" />

            <Frame Padding="25" CornerRadius="20" HasShadow="True" BorderColor="Transparent" BackgroundColor="White">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Desenvolvido por:" FontSize="16" TextColor="Gray" HorizontalOptions="Center"/>
                    <Label Text="Seu Nome Completo Aqui" FontSize="22" FontAttributes="Bold" TextColor="#003366" HorizontalOptions="Center" />

                    <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,10" />

                    <Label Text="Ano de Desenvolvimento:" FontSize="16" TextColor="Gray" HorizontalOptions="Center"/>
                    <Label Text="2026" FontSize="20" FontAttributes="Bold" TextColor="#003366" HorizontalOptions="Center" />

                    <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,10" />

                    <Label Text="Este aplicativo foi criado como parte da atividade prática de .NET MAUI, focado na criação de interfaces e navegação entre telas." 
                           FontSize="14" HorizontalTextAlignment="Center" TextColor="#555555" />
                </VerticalStackLayout>
            </Frame>

            <Button Text="Voltar" Clicked="OnVoltarClicked" BackgroundColor="#003366" TextColor="White" CornerRadius="10" HorizontalOptions="Center" WidthRequest="150" HeightRequest="45" Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>